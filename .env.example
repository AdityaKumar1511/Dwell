# Supabase project settings → API
# The URL is safe to expose. The "anon" key may be either the legacy JWT anon key
# or the newer publishable key (sb_publishable_...). Never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used exclusively in lib/supabase/admin.ts.
# Never import that module into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Leave blank to derive redirect links from the request host — correct
# for localhost and most deploys. Set it only when the canonical domain differs
# from the deployment URL (e.g. a custom domain on a preview).
NEXT_PUBLIC_SITE_URL=
